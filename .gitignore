# Build output — regenerated by the toolchain, never a source of truth.
build/
.gradle/
# The Kotlin Gradle plugin's session and error files (Kotlin 2).
.kotlin/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Python bytecode.
__pycache__/
*.pyc

# Local scratch. Nothing here is an artifact.
*.log

# SwiftPM build products and local package state.
.build/
.swiftpm/

# Xcode local user state.
xcuserdata/

# A local tool's crawl cache; never part of the product.
.claude-crawl/
.neon
.env.local
# Written by xcodebuild archive; nothing in it is ours.
apps/ios/ThroDarts.xcodeproj/project.xcworkspace/xcshareddata/
